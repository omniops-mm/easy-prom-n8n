# Metrics preset for the bundled demo instance (compose profile "demo").
# Turns on everything the shipped dashboards read, so no panel is empty for
# want of a flag. For a real instance use the sets in the README instead: the
# *_LABEL flags below multiply series count per workflow and node type.

N8N_METRICS=true
# the dashboards and alerts expect the n8n_ prefix
N8N_METRICS_PREFIX=n8n_

# --- metric families --------------------------------------------------------

# process and Node.js runtime: CPU, memory, event loop, GC
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
# execution duration histogram, labelled by status and mode
N8N_METRICS_INCLUDE_WORKFLOW_EXECUTION_DURATION=true
# event-bus counters: workflow and node started, success, failed
N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS=true
# workflow id -> name gauges; the executions dashboard joins on these
N8N_METRICS_INCLUDE_WORKFLOW_INFO=true
# DB-backed instance totals
N8N_METRICS_INCLUDE_WORKFLOW_STATISTICS=true
# n8n default is 300; lowered so the demo panels fill quickly
N8N_METRICS_WORKFLOW_STATISTICS_INTERVAL=60
# API route histogram and the n8n_last_activity gauge
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
# webhook histogram; fed by the load generator
N8N_METRICS_INCLUDE_WEBHOOK_METRICS=true
# form histogram; no demo workflow uses a form trigger, so this stays empty
N8N_METRICS_INCLUDE_FORM_METRICS=true
# queue depth; the single-process demo reports zeroes
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
# internals: cache, connection pool, scheduler, execution data IO
N8N_METRICS_INCLUDE_CACHE_METRICS=true
N8N_METRICS_INCLUDE_SCHEDULER_METRICS=true
N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true
# acquire latency is Postgres-only; the demo runs SQLite, so it stays empty
N8N_METRICS_INCLUDE_DB_POOL_METRICS=true

# --- optional labels --------------------------------------------------------

N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=true
N8N_METRICS_INCLUDE_API_METHOD_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true
# off even here: the value is the raw URL, not a route template, so every
# workflow touched through the API mints a new histogram without bound
N8N_METRICS_INCLUDE_API_PATH_LABEL=false

# --- logging ----------------------------------------------------------------

# JSON on stdout; the logs profile ships this to Loki via Vector
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_LOG_FORMAT=json

# --- keep the demo quiet and offline ----------------------------------------

N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_DYNAMIC_BANNERS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
# the seed drives the internal REST API only
N8N_PUBLIC_API_DISABLED=true
# keeps the UI usable over plain HTTP if the port mapping is uncommented
N8N_SECURE_COOKIE=false
# n8n defaults to America/New_York; UTC matches the Grafana time range
GENERIC_TIMEZONE=Etc/UTC
