# Metrics preset for the bundled demo instance (compose profile "demo").
# Turns on every metric family and every optional label except the API path
# label, so each shipped panel has data behind it. For a production instance
# use the presets in docs/flags.md instead: the *_LABEL flags below multiply
# series count per workflow/node/credential type.

# serve GET /metrics on the main port
N8N_METRICS=true
# dashboards and alerts expect the n8n_ prefix
N8N_METRICS_PREFIX=n8n_

# --- metric families --------------------------------------------------------

# process + Node.js runtime: CPU, memory, event loop, GC
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
# execution duration histogram, labelled by status and mode
N8N_METRICS_INCLUDE_WORKFLOW_EXECUTION_DURATION=true
# event-bus counters: workflow/node started, success, failed; reset on restart
N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS=true
# workflow id -> name gauges, used by the dashboard name joins
N8N_METRICS_INCLUDE_WORKFLOW_INFO=true
# DB-backed instance totals: executions, users, workflows, credentials
N8N_METRICS_INCLUDE_WORKFLOW_STATISTICS=true
# refresh of those totals; n8n default 300, lowered so demo panels fill fast
N8N_METRICS_WORKFLOW_STATISTICS_INTERVAL=60
# internal API/UI route histogram + the n8n_last_activity gauge
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
# production webhook histogram; fed by the load generator
N8N_METRICS_INCLUDE_WEBHOOK_METRICS=true
# form-trigger histogram; no demo workflow uses one, stays empty
N8N_METRICS_INCLUDE_FORM_METRICS=true
N8N_METRICS_INCLUDE_CACHE_METRICS=true
# queue depth/jobs; single-process demo reports zeroes
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
N8N_METRICS_INCLUDE_SCHEDULER_METRICS=true
N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true
# acquire latency is Postgres-only; demo runs SQLite, that histogram stays empty
N8N_METRICS_INCLUDE_DB_POOL_METRICS=true

# --- optional labels (cardinality cost per distinct value) ------------------

N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
# redundant with WORKFLOW_INFO; on here so the raw counters read well ad hoc
N8N_METRICS_INCLUDE_WORKFLOW_NAME_LABEL=true
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=true
# off even in the demo: the value is the raw URL, not a route template, so
# every workflow touched mints a new 17-bucket histogram (unbounded), and it
# puts workflow ids into Prometheus
N8N_METRICS_INCLUDE_API_PATH_LABEL=false
N8N_METRICS_INCLUDE_API_METHOD_LABEL=true
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=true

# --- logging ----------------------------------------------------------------

# JSON on stdout; the "logs" profile ships this to Loki via Vector
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_LOG_FORMAT=json

# --- keep the demo quiet and offline ----------------------------------------

# telemetry to n8n's PostHog endpoints
N8N_DIAGNOSTICS_ENABLED=false
# version check + feed from api.n8n.io
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_DYNAMIC_BANNERS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
# first-login survey + the sample workflows it seeds
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
# the seed drives the internal REST API only
N8N_PUBLIC_API_DISABLED=true
# keeps the UI usable over plain HTTP if the port mapping is uncommented
N8N_SECURE_COOKIE=false
# n8n defaults to America/New_York; UTC keeps schedule timestamps in line
# with the Grafana time range
GENERIC_TIMEZONE=Etc/UTC
