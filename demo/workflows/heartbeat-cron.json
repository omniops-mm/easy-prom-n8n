      "name": "Every 30 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "3c7b41a2-8d5e-4f60-b19a-2e6c8d4f7b13",
      "name": "Mark healthy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"status\":\"ok\",\"source\":\"EasyPromN8N demo heartbeat\"}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 30 seconds": {
      "main": [
        [
          {
            "node": "Mark healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
