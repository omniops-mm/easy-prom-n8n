{
  "id": null,
  "uid": "epn8n-internals",
  "title": "n8n / Internals",
  "tags": [
    "n8n"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "weekStart": "",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up, job)",
        "current": {
          "text": "n8n",
          "value": "n8n"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"$job\"}, instance)",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard needs",
      "description": "Lists the n8n metric flags the rows below depend on, and the metric names that are not fully verified.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Flags needed beyond `N8N_METRICS=true`: `N8N_METRICS_INCLUDE_CACHE_METRICS`, `N8N_METRICS_INCLUDE_DB_POOL_METRICS`, `N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS`, `N8N_METRICS_INCLUDE_SCHEDULER_METRICS` (all =true).\n\nScheduler metrics come from main instances only; the pool acquire histogram is Postgres-only. `scripts/doctor.sh` reports what your instance has."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Cache",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Cache hit ratio",
      "description": "Cache hits divided by hits plus misses over the last 5 minutes. The denominator is wrapped in clamp_min so an idle cache reads 0 instead of NaN. A ratio that drops after a deployment usually means the cache is being invalidated more often than it is filled. Needs N8N_METRICS_INCLUDE_CACHE_METRICS=true.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(n8n_cache_hits_total{job=\"$job\", instance=~\"$instance\"}[5m])) or vector(0)) / clamp_min(sum(rate(n8n_cache_hits_total{job=\"$job\", instance=~\"$instance\"}[5m])) + sum(rate(n8n_cache_misses_total{job=\"$job\", instance=~\"$instance\"}[5m])), 0.000001)",
          "legendFormat": "hit ratio",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hits and misses",
      "description": "Cache lookups per second, split into hits and misses. These are in-process counters that reset when n8n restarts, so they are graphed through rate(). Needs N8N_METRICS_INCLUDE_CACHE_METRICS=true.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(n8n_cache_hits_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "hits",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(n8n_cache_misses_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "misses",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache updates",
      "description": "Cache writes per second. Sustained updates without a matching rise in hits mean the cached entries are not being read back before they are replaced. Needs N8N_METRICS_INCLUDE_CACHE_METRICS=true.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(n8n_cache_updates_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "updates",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Database pool",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool connections",
      "description": "Active, idle and maximum connections in the n8n database pool, per instance. Active sitting at the maximum for long stretches means queries are queueing behind the pool rather than behind the database. Needs N8N_METRICS_INCLUDE_DB_POOL_METRICS=true. The queries assume the metric names carry the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*max.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (n8n_db_pool_connections_active{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} active",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (n8n_db_pool_connections_idle{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} idle",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (n8n_db_pool_connections_max{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} max",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Pending pool requests",
      "description": "Callers currently waiting for a free database connection, taken as the worst instance. Anything above zero for a sustained period means the pool is saturated and the connection limit, not the database, is the bottleneck. Needs N8N_METRICS_INCLUDE_DB_POOL_METRICS=true. The query assumes the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 20,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(n8n_db_pool_requests_pending{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "pending",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Connection acquire time p95",
      "description": "95th percentile time spent waiting to check a connection out of the pool. This histogram is emitted for Postgres only, so the panel stays empty on SQLite installations. Needs N8N_METRICS_INCLUDE_DB_POOL_METRICS=true. The query assumes the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(n8n_db_pool_acquire_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Execution data",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Execution data reads by result",
      "description": "Reads per second of stored execution data, split by the result label. A rising error series points at truncated or unreadable execution payloads. Needs N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true. The query assumes the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(n8n_execution_data_reads_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Execution data writes by result",
      "description": "Writes per second of execution data, split by the result label. Compare against the execution rate on the executions dashboard: far more writes than executions usually means large payloads are being saved per node. Needs N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true. The query assumes the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (result) (rate(n8n_execution_data_writes_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{result}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Execution data write throughput",
      "description": "Bytes per second written as execution data, split by execution mode. This is the number that drives database growth, so use it when sizing retention. Needs N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true. The query assumes the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (mode) (rate(n8n_execution_data_write_bytes_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Execution data read and write duration p95",
      "description": "95th percentile time spent reading and writing execution data. Rising write duration next to flat throughput points at the database rather than at payload size. Needs N8N_METRICS_INCLUDE_EXECUTION_DATA_METRICS=true. The queries assume the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(n8n_execution_data_read_duration_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "read p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(n8n_execution_data_write_duration_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "write p95",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Scheduler",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Scheduler tasks pending, due and running",
      "description": "Queue depth of the internal scheduler, per instance. Scheduler metrics are produced on main instances only, so worker targets contribute nothing here. Due staying above zero while running stays flat means occurrences are piling up faster than they are dispatched. Needs N8N_METRICS_INCLUDE_SCHEDULER_METRICS=true. The queries assume the default n8n_ prefix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
