# cp .env.example .env  (.env is gitignored)
# A $ in a value is a compose variable reference; escape as $$.

GRAFANA_ADMIN_USER=admin

# required, no default. Generate: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Prometheus sample retention; sizes the prometheus_data volume
PROM_RETENTION=15d

# optional service groups, comma-separated: demo (a bundled n8n with seeded
# workflows and a load generator), logs (Loki + Vector; also needs
# -f compose.logs.yaml), queue (queue-mode demo; also needs
# -f compose.demo-queue.yaml). A typo here is not an error; the services
# simply never start.
COMPOSE_PROFILES=

# --- queue-mode demo only ---------------------------------------------------
# Ignored unless compose.demo-queue.yaml is used.

# Shared secret n8n uses to encrypt stored credentials; main and every worker
# must hold the same value. Changing it later makes existing credentials
# unreadable. No default. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Database name and user, created on first start.
POSTGRES_DB=n8n
POSTGRES_USER=n8n

# No default: an empty password would leave the database open to anything on
# the compose network. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
