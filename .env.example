# cp .env.example .env   (.env is gitignored)

# required, no default. Generate one: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# how long Prometheus keeps samples; sizes the prometheus_data volume
PROM_RETENTION=15d

# only for the external-network mode: the Docker network your n8n's compose
# project created. Usually <its-directory>_default; docker network ls shows it.
N8N_NETWORK=n8n_default

# optional service groups, comma-separated: demo, logs.
# A typo here is not an error; the services simply never start.
COMPOSE_PROFILES=
